# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real secrets.

# Kaggle username (for dataset/kernel slugs like <username>/boltu-tokens) and API token
# (kaggle.com/settings -> API -> Create New Token). Kaggle CLI 2.x auth is a single bearer
# token now, not the old username+key pair — the `kaggle` CLI reads KAGGLE_API_TOKEN directly.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# GitHub personal access token (repo scope). Store the SAME value as a Kaggle Secret
# named GH_TOKEN too (notebook Add-ons -> Secrets) — that's what kernel/run.ipynb reads
# on Kaggle. This .env copy is just for local git/CLI use.
GH_TOKEN=
