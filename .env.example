# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real secrets.

# Kaggle API credentials (kaggle.com/settings -> API -> Create New Token).
# The `kaggle` CLI reads these two vars directly, no config file needed.
KAGGLE_USERNAME=
KAGGLE_KEY=

# GitHub personal access token (repo scope). Store the SAME value as a Kaggle Secret
# named GH_TOKEN too (notebook Add-ons -> Secrets) — that's what kernel/run.ipynb reads
# on Kaggle. This .env copy is just for local git/CLI use.
GH_TOKEN=
