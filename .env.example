# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real secrets.

# Kaggle username (for dataset/kernel slugs like <username>/boltu-tokens) and API token
# (kaggle.com/settings -> API -> Create New Token). Kaggle CLI 2.x auth is a single bearer
# token now, not the old username+key pair — the `kaggle` CLI reads KAGGLE_API_TOKEN directly.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# GitHub username and personal access token (repo scope). Store GH_TOKEN as a Kaggle Secret
# too (notebook Add-ons -> Secrets) — that's what kernel/run.ipynb and kernel-prep/prep.ipynb
# read on Kaggle. This .env copy is for local git/CLI use.
GH_USERNAME=
GH_TOKEN=
